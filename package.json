{
  "name": "react-native-sia",
  "version": "0.16.1",
  "description": "The Sia SDK for React Native.",
  "main": "./lib/module/public.js",
  "types": "./lib/typescript/src/public.d.ts",
  "exports": {
    ".": {
      "source": "./src/public.ts",
      "types": "./lib/typescript/src/public.d.ts",
      "default": "./lib/module/public.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "ubrn:ios": "RUSTUP_TOOLCHAIN=nightly ubrn build ios --release --and-generate && (cd example/ios && pod install)",
    "ubrn:android": "ubrn build android --and-generate --release",
    "ubrn:web": "ubrn build web",
    "ubrn:checkout": "ubrn checkout",
    "ubrn:clean": "del-cli cpp android/CMakeLists.txt android/src/main/java 'android/*.cpp' ios 'src/Native*' 'src/index.*ts*' src/generated SiaFramework.xcframework",
    "example": "yarn workspace react-native-sia-example",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.build.json",
    "test:package": "node scripts/check-package.mjs",
    "lint": "oxlint . && oxfmt --check --ignore-path .gitignore --ignore-path .oxfmtignore .",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "lint:fix": "oxlint --fix . && oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore ."
  },
  "dependencies": {
    "@ubjs/core": "^0.31.0-5",
    "uniffi-bindgen-react-native": "0.31.0-5"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "del-cli": "^7.0.0",
    "jest": "^30.5.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "SiaFramework.xcframework/**",
    "*.podspec",
    "!rust",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "keywords": [
    "sia",
    "sia-sdk",
    "indexd",
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiaFoundation/react-native-sia.git"
  },
  "author": "The Sia Foundation <hello@sia.tech> (https://github.com/SiaFoundation)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SiaFoundation/react-native-sia/issues"
  },
  "homepage": "https://github.com/SiaFoundation/react-native-sia#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "workspaces": [
    ".",
    "example"
  ],
  "packageManager": "yarn@3.6.1",
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "SiaSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.sia"
    }
  },
  "create-react-native-library": {
    "languages": "kotlin-objc",
    "type": "turbo-module",
    "version": "0.53.0"
  }
}
